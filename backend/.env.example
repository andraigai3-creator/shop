# ─────────────────────────────────────────────────────────────
# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Токен бота от BotFather (обязательно)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram chat_id — куда приходят уведомления о заказах (обязательно)
# Как узнать: напиши боту @userinfobot — он покажет твой ID
SELLER_CHAT_ID=123456789

# URL задеплоенного фронтенда (обязательно)
# Например: https://tazakkur.vercel.app или https://username.github.io/islamic-shop
WEBAPP_URL=https://YOUR_APP.vercel.app

# Telegram-юзернейм продавца без @ (для кнопки «Связаться с продавцом»)
SELLER_USERNAME=tazakkur_support
